<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ========================= -->
    <!-- Spring Properties         -->
    <!-- ========================= -->

    <springProperty
            scope="context"
            name="applicationName"
            source="spring.application.name"/>

    <springProperty
            scope="context"
            name="env"
            source="spring.application.env"/>


    <!-- ========================= -->
    <!-- Console                   -->
    <!-- ========================= -->

    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">

        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} %cyan([%thread]) %highlight(%-5level) %green(%logger{36}) - %msg%n
            </pattern>
        </encoder>

    </appender>


    <!-- ========================= -->
    <!-- File                      -->
    <!-- ========================= -->

    <appender name="FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <!-- Current log file -->
        <file>logs/${applicationName}.log</file>

        <!-- Rolling policy -->
        <rollingPolicy
                class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <!-- Archived logs -->
            <fileNamePattern>
                logs/archive/${applicationName}.%d{yyyy-MM-dd}.%i.log.gz
            </fileNamePattern>

            <!-- Maximum size of each file -->
            <maxFileSize>50MB</maxFileSize>

            <!-- Keep logs for 7 days -->
            <maxHistory>7</maxHistory>

            <!-- Maximum total size of archived logs -->
            <totalSizeCap>1GB</totalSizeCap>

        </rollingPolicy>

        <!-- IMPORTANT:
             No ANSI colors here.
             Alloy/Loki should receive plain text. -->
        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n
            </pattern>
        </encoder>

    </appender>


    <!-- ========================= -->
    <!-- Root Logger               -->
    <!-- ========================= -->

    <root level="INFO">

        <!-- Colored output for developer console -->
        <appender-ref ref="CONSOLE"/>

        <!-- Clean file for Alloy -> Loki -->
        <appender-ref ref="FILE"/>

    </root>

</configuration>